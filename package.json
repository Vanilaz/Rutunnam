{
  "name": "ru-tan-nam",
  "version": "0.6.1",
  "private": true,
  "description": "Thailand flood watch: bank overflow, flood extent, flooded roads, water gates, dams, traffic and CCTV on one map (Vercel)",
  "scripts": {
    "dev": "node dev-server.js",
    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build": "tsc -p . && node scripts/check-build.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
