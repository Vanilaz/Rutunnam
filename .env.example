# Copy the names into Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Every variable is optional; missing keys only disable that layer.

# Satellite flood extent (GISTDA API gateway). Server-side only; never sent to browsers.
GISTDA_API_KEY=
# 1day | 3days | 7days (default 7days)
GISTDA_FLOOD_PERIOD=7days

# Live traffic tiles. Visible to browsers by design: restrict the key to your domain.
TOMTOM_API_KEY=
# Optional: another traffic tile provider instead of TomTom (https, with {z} {x} {y}).
TRAFFIC_TILE_URL=
TRAFFIC_ATTRIBUTION=

# Local development only.
PORT=3000
