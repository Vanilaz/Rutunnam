{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowUmdGlobalAccess": true,
    "types": [
      "node",
      "leaflet"
    ],
    "skipLibCheck": true
  },
  "include": [
    "api/**/*.js",
    "lib/**/*.js",
    "public/js/**/*.js",
    "scripts/**/*.js",
    "dev-server.js",
    "types/**/*.d.ts",
    "tests/e2e/**/*.js",
    "playwright.config.js"
  ]
}
